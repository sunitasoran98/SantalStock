    "faqs": [
      {
        "id": "fq1",
        "q": "Royalty-Free ka matlab free hai?",
        "a": "Nahi. Ek baar bahut kam minimum fees (₹19 se shuru) deni hoti hai, phir har use par alag royalty nahi deni padti."
      },
      {
        "id": "fq2",
        "q": "Editorial photo ad me laga sakte hain?",
        "a": "Nahi. Editorial sirf news/info, blog aur documentary context ke liye hai."
      },
      {
        "id": "fq3",
        "q": "License kitne samay ka hai?",
        "a": "Perpetual (hamesha ke liye), license ki shartein ke andar."
      },
      {
        "id": "fq4",
        "q": "Invoice milega?",
        "a": "Haan, har order par GST invoice (CGST/SGST ya IGST) milta hai."
      },
      {
        "id": "fq5",
        "q": "Contributor ko paisa kab milta hai?",
        "a": "Balance sirf ₹100 hone par payout request karein; UPI/bank me bheja jaata hai."
      }
    ],
    "pages": {
      "about": {
        "title": "About SantalStock",
        "body": "SantalStock is a stock photo marketplace for the life, culture and nature of Santal country, run by BOSC (Baski Online Service Center) from Godda, Jharkhand. We help local photographers earn from their work and help publishers, brands and educators find authentic images with affordable minimum pricing and clear licenses."
      },
      "privacy": {
        "title": "Privacy Policy",
        "body": "We collect only what we need to run your account and orders: name, verified email, billing details and order history. We never sell your data. Payments are processed securely; we do not store card numbers. You can ask us to delete your account at any time by writing to support@santalstock.in."
      },
      "refund": {
        "title": "Refund Policy",
        "body": "If you have not downloaded the full-resolution file, you can request a full refund within 7 days of purchase. Once a license is refunded, you must stop using the image. Subscription plans can be cancelled anytime; unused credits stay valid until the end of the period. Write to support@santalstock.in with your order number."
      },
      "terms": {
        "title": "SantalStock License Agreement",
        "sections": [
          {
            "id": "t1",
            "heading": "1. Grant",
            "content": "SantalStock aapko (Licensee) chuni gayi image ka non-exclusive, non-transferable, perpetual, worldwide license deta hai, chune gaye license type ki shartein ke anusaar."
          },
          {
            "id": "t2",
            "heading": "2. Royalty-Free Standard",
            "content": "Digital use unlimited; print 5,00,000 copies tak; advertising aur marketing allowed. Merchandise for resale aur templates allowed nahi."
          },
          {
            "id": "t3",
            "heading": "3. Royalty-Free Extended",
            "content": "Standard ke sab adhikar, plus unlimited print, resale ke liye merchandise, templates aur packaging."
          },
          {
            "id": "t4",
            "heading": "4. Editorial",
            "content": "Sirf editorial use: news, commentary, education, documentary. Koi commercial, advertising, promotional, endorsement ya merchandise use nahi. Credit line \"Contributor / SantalStock\" zaroori."
          },
          {
            "id": "t5",
            "heading": "5. Prohibited (sab licenses)",
            "content": "Image ko standalone file ki tarah bechna/share karna, logo/trademark me use, apmanjanak ya gair-kanooni sandarbh, ya AI/ML model training dataset me use mana hai."
          },
          {
            "id": "t6",
            "heading": "6. Contributor Terms & Law",
            "content": "Copyright contributor ke paas rehta hai. Bharat ka kanoon laagu; jurisdiction: Godda, Jharkhand."
          }
        ]
      }
    },
